<Page
    x:Class="Lumidlet.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="LUMIDLET" Margin="16,12,16,0" FontSize="15" FontWeight="SemiBold" Opacity="0.7" />
        <TextBlock Text="games" Margin="14,26,16,8" FontSize="44" FontWeight="Light" />
        <ListView x:Name="List" Grid.Row="1" IsItemClickEnabled="True" ItemClick="List_ItemClick" SelectionMode="None" Padding="0,0,0,8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,8" Holding="Item_Holding" RightTapped="Item_RightTapped" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" Background="{ThemeResource SystemControlBackgroundAccentBrush}" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="14" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Empty" Grid.Row="1" Margin="16,8" TextWrapping="Wrap" Opacity="0.7" FontSize="16" Visibility="Collapsed"
                   Text="No games yet. Tap + to add a .jar file (and its .jad, if you have one). You can also open .jar files from File Explorer." />
        <ProgressRing x:Name="Busy" Grid.Row="1" Width="48" Height="48" IsActive="False" />
        <CommandBar Grid.Row="2">
            <AppBarButton Icon="Add" Label="add game" Click="Add_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="about" Click="About_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Grid>
</Page>
